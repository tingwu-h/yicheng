# Copy to .env for local development. Never place secrets in a VITE_ variable.
API_PORT=5181
API_HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:5180,http://localhost:5180
TZ=Asia/Shanghai
# Online accounts are the default. Use VITE_APP_MODE=demo only for a separate offline demo.
VITE_APP_MODE=server
# Production: NODE_ENV=production, PUBLIC_ORIGIN=https://YOUR_PUBLIC_IP, TRUST_PROXY=1
